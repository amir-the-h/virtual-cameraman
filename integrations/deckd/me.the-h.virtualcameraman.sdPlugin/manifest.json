{
  "UUID": "me.the-h.virtualcameraman",
  "Name": "Virtual Cameraman",
  "Version": "1.0.0",
  "Author": "Amir H",
  "Description": "Start, stop and switch sources of Virtual Cameraman through its local HTTP API",
  "Icon": "imgs/plugin",
  "Category": "Virtual Cameraman",
  "CategoryIcon": "imgs/plugin",
  "CodePath": "plugin.js",
  "PropertyInspectorPath": "pi/index.html",
  "Nodejs": { "Version": "22" },
  "SDKVersion": 2,
  "Software": { "MinimumVersion": "6.4" },
  "OS": [{ "Platform": "linux", "MinimumVersion": "5.0" }],
  "Actions": [
    {
      "UUID": "me.the-h.virtualcameraman.toggle",
      "Name": "Capture On/Off",
      "Tooltip": "Start or stop the virtual camera",
      "Icon": "imgs/toggle/icon",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/toggle/off/key" }, { "Image": "imgs/toggle/on/key" }]
    },
    {
      "UUID": "me.the-h.virtualcameraman.switch",
      "Name": "Switch Camera",
      "Tooltip": "Turn to switch between camera sources",
      "Icon": "imgs/switch/icon",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/switch/icon" }],
      "Encoder": { "layout": "$A1", "TriggerDescription": { "Rotate": "Switch camera" } }
    }
  ]
}
